<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/bycourse/db" VERSION="20261030" COMMENT="XMLDB file for enrol_bycourse">
  <TABLES>
    <TABLE NAME="enrol_bycourse_req" COMMENT="Prerequisite courses for conditional enrolment instances">
